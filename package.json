{
  "name": "pintintin",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:server": "pnpm --filter @pintintin/server dev",
    "dev:mobile": "pnpm --filter @pintintin/mobile start"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
