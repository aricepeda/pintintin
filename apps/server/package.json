{
  "name": "@pintintin/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --include ../../packages/**/src/**/*.ts src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@pintintin/game-core": "workspace:*",
    "@pintintin/protocol": "workspace:*",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.1",
    "@supabase/supabase-js": "^2.45.0",
    "jose": "^5.6.3",
    "pino": "^9.3.2",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  }
}
